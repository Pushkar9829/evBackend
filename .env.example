# ---- copy to .env for local development ----
NODE_ENV=development
PORT=4410
MONGO_URI=mongodb://127.0.0.1:27017/ev_charging
JWT_SECRET=change-me-to-a-long-random-string

# Browser origins allowed to call the API (comma separated; wildcard like https://*.vercel.app works)
CORS_ORIGINS=http://localhost:5410
# Used in QR codes, SMS links and the OCPP URL shown to technicians
PUBLIC_WEB_URL=http://localhost:5410
PUBLIC_API_URL=http://localhost:4410

# Demo/mock mode: every OTP equals this code and SMS is logged instead of sent. Leave empty in production.
DEMO_OTP_CODE=123456

# Payments: mock (built-in gateway) or razorpay
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=mock-webhook-secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMS: mock or msg91
SMS_PROVIDER=mock
MSG91_AUTH_KEY=

# Seed data passwords (test values for local/demo only)
SEED_STAFF_PASSWORD=Demo@12345
SEED_CHARGER_PASSWORD=charger-demo-pass

# OCPI identity of the platform (eMSP role)
OCPI_COUNTRY=IN
OCPI_PARTY_ID=CHX
# UEI / Beckn subscriber id; keys are generated on first use unless provided (base64 DER)
UEI_SUBSCRIBER_ID=bpp.chargex.in
UEI_PRIVATE_KEY=
UEI_PUBLIC_KEY=

GST_RATE_BPS=1800
JOBS_ENABLED=true

# ---- Multi-instance (optional): Redis for charger registry, command routing, live updates, job leader
REDIS_URL=

# ---- Real providers (optional; mock/log when empty)
# SMS + WhatsApp via MSG91 (set SMS_PROVIDER=msg91); template DLT/flow ids are set per template in the console
MSG91_SENDER=
MSG91_WA_NUMBER=
# Push: Firebase service-account JSON (raw or base64)
FCM_SERVICE_ACCOUNT=
# Email (AWS SES SMTP works): smtp://user:pass@email-smtp.ap-south-1.amazonaws.com:587
SMTP_URL=
EMAIL_FROM=ChargeX <no-reply@chargex.in>

# ---- OCPP Security Profile 3 (optional, self-hosted or TCP pass-through LB only)
OCPP_TLS_PORT=
OCPP_TLS_CERT=
OCPP_TLS_KEY=
OCPP_TLS_HOSTS=
OCPP_TLS_PUBLIC_URL=
# CSMS CA (PEM or base64); generated and stored in the DB when empty
PKI_CA_CERT=
PKI_CA_KEY=
# ISO 15118 Contract Certificate Pool for Get15118EVCertificate (EXI pass-through)
CCP_URL=
CCP_TOKEN=

# ---- Route planner: OSRM-compatible router for road geometry (straight line when empty)
ROUTING_URL=
