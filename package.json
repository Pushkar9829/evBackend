{
  "name": "chargex-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ChargeX EV charging platform: REST API, OCPP 2.0.1/1.6J gateway, OCPI 2.2.1 + UEI roaming",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "sim": "node scripts/simulate.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5",
    "pdfkit": "^0.15.2",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
